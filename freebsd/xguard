#!/bin/sh

# PROVIDE: xguard
# REQUIRE: NETWORKING wireguard
# KEYWORD: shutdown

. /etc/rc.subr

name="xguard"
rcvar=xguard_enable
command="/usr/local/bin/xguard"
xguard_env_file="/etc/xguard/core.conf"
start_cmd="${name}_start"

xguard_start() {
	${command} &
}

load_rc_config $name
run_rc_command "$1"
