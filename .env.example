### DB configuration ###
XGUARD_DB_HOST="localhost"
XGUARD_DB_PORT=5432
XGUARD_DB_NAME="xguard"
XGUARD_DB_USER="xguard"
XGUARD_DB_PASSWORD="xguard"
# for SQLX CLI
DATABASE_URL="postgresql://xguard:xguard@localhost/xguard"

### For localhost only ###
# XGUARD_COOKIE_INSECURE=true

### Logging ###
XGUARD_LOG_LEVEL=info
# XGUARD_LOG_FILE=xguard.log
# never, hourly, daily, weekly
# XGUARD_LOG_FILE_ROTATION=daily
# XGUARD_LOG_FILE_MAX_FILES=30

### HTTP Port ###
XGUARD_HTTP_PORT=8000

### GRPC Port ###
XGUARD_GRPC_PORT=50055
# XGUARD_GRPC_BIND_ADDRESS=
# XGUARD_HTTP_BIND_ADDRESS=

### OpenID Connect ###
# XGUARD_OPENID_KEY=

### Docker-compose images ###
IMAGE_TAG=dev
